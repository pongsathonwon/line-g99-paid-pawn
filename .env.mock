# `npm run dev:mock`: fake LINE login + fake APIs (src/dev-mock). These URLs
# are never called (the mock adapters answer first); they only make sure a
# missed route fails locally instead of reaching production.
VITE_LIFF_ID=mock-liff-id
VITE_BASE_URL=http://localhost:5174/__mock__/g99-online
VITE_SURVEY_API_URL=http://localhost:5174/__mock__/survey/
VITE_APP_VERSION=mock
